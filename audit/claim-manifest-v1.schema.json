{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vdw-claim-manifest/v1",
  "title": "VDW succinct Rabung claim evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim", "build", "runs", "final"],
  "properties": {
    "schema": {"const": "vdw-claim-manifest/v1"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "colors", "length", "prime", "lower_bound", "origin",
        "priority_credit", "evidence_class"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "colors": {"type": "integer", "minimum": 2},
        "length": {"type": "integer", "minimum": 2},
        "prime": {"type": "integer", "minimum": 2},
        "lower_bound": {"type": "integer", "minimum": 1},
        "origin": {"type": "string", "minLength": 1},
        "priority_credit": {"type": "string", "minLength": 1},
        "evidence_class": {"const": "succinct_rabung_certificate"},
        "requires_montgomery_free_witness": {"type": "boolean"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit", "git_clean", "sources_sha256", "binaries_sha256",
        "compile_commands", "compiler_versions"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_clean": {"const": true},
        "sources_sha256": {"$ref": "#/$defs/hashMap"},
        "binaries_sha256": {"$ref": "#/$defs/hashMap"},
        "compile_commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "compiler_versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 5,
      "items": {"$ref": "#/$defs/run"}
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "fail_closed"],
      "properties": {
        "verdict": {"const": "ACCEPT"},
        "fail_closed": {"const": true}
      }
    }
  },
  "$defs": {
    "hashMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "attempt", "argv", "exit_code", "stdout", "stderr",
        "parsed"
      ],
      "properties": {
        "stage": {
          "enum": [
            "scan_gpu_verify1", "rabung_criterion", "verify_claim",
            "highp_witness"
          ]
        },
        "attempt": {"type": "integer", "minimum": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exit_code": {"type": "integer"},
        "stdout": {"$ref": "#/$defs/artifact"},
        "stderr": {"$ref": "#/$defs/artifact"},
        "parsed": {"type": "object"}
      }
    }
  }
}
